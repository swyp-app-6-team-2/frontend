{
  "expo": {
    "name": "별따먹자",
    "slug": "orca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orca",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.byeolddameokja.app",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.byeolddameokja.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070C22",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "레시피 사진을 등록하려면 사진 접근 권한이 필요해요."
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "fdfad3d5121019dcff5345ec59968478"
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "naverlogin"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.844378154938-9lhifn3h276dgbsebefdimdkoo6jjvcq"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79f3b953-0651-4384-91dd-bc878b19dc19"
      }
    },
    "owner": "leeseunghwan123",
    "updates": {
      "url": "https://u.expo.dev/79f3b953-0651-4384-91dd-bc878b19dc19"
    }
  }
}
