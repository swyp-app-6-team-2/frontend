{
  "expo": {
    "name": "별따먹자",
    "slug": "orca",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orca",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.byeolddameokja.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.byeolddameokja.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#6546E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070C22",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "android": {
            "backgroundColor": "#070C22",
            "image": "./assets/images/android-icon-foreground.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "레시피 사진을 등록하려면 사진 접근 권한이 필요해요."
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "fdfad3d5121019dcff5345ec59968478"
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "starpicknaver"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.844378154938-9lhifn3h276dgbsebefdimdkoo6jjvcq"
        }
      ],
      "expo-secure-store",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79f3b953-0651-4384-91dd-bc878b19dc19"
      }
    },
    "owner": "leeseunghwan123",
    "updates": {
      "url": "https://u.expo.dev/79f3b953-0651-4384-91dd-bc878b19dc19"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
