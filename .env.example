# 복사해서 .env.local 로 쓰세요 (개인 값은 .env.local, 이 파일은 커밋됨).
#
# 백엔드 호스트. 스킴+호스트+포트까지만, 끝에 /api/v1 이나 슬래시는 붙이지 않는다
# (클라이언트가 /api/v1 을 붙임). 예:
#   - 로컬 백엔드(같은 네트워크): http://<백엔드-머신-IP>:8080
#   - 배포:                       https://api.example.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 구글 로그인 (expo-auth-session) — Google Cloud Console에서 발급.
#   - IOS: iOS OAuth 클라이언트 ID (번들 com.byeolddameokja.app)
#   - WEB: 웹 OAuth 클라이언트 ID (백엔드 검증용 audience와 동일해야 함)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
